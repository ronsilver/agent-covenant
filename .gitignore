# IDEs
.vscode
.idea
*.swp
*.swo
*~

# macOS
.DS_Store

# Backup files (generated by sync.sh --backup)
*.bak

# Temporary files
tmp/
temp/
output/

# Environment files with secrets (never commit!)
# *.env covers .env, .env.local, and any path ending in .env
*.env

# MCP configurations with actual tokens (synced versions are safe)
**/mcp.json.local

# Local Claude Code settings with machine-specific paths (use .example as template)
.claude/settings.local.json

# MCP build artifacts
mcps/**/node_modules/
mcps/**/dist/
mcps/**/.cache/

# Python bytecode
__pycache__/
*.pyc

# Ephemeral docs (conversation logs, local reports)
docs/conversation/

# Evaluation artifacts (generated by evaluate_skill.py / evaluate_ecosystem.py)
**/workspace/
ecosystem-quality-report*.json
tests/benchmark/out/

# Test fixtures (generated)
tests/fixtures/

docs/plans
plans

# Local manifest (use manifest.example.yaml as committed template)
manifest.yaml

# Shared agent-covenant directory (user-local, not committed)
agent-covenant/

/.gitnexus/
# Agent Covenant shared directory (local deploy target, not repo content)
~/.config/agent-covenant/

.claude
.opencode
# =============================================================================
# MCP Servers Environment Variables
# =============================================================================
# Copy this file to your shell profile (~/.zshrc, ~/.bashrc) or use direnv
# 
# Usage:
#   cp content/mcp/.env.example ~/.mcp.env
#   echo "source ~/.mcp.env" >> ~/.zshrc
#
# IMPORTANT: Never commit actual tokens to git!
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
# Required for: github-mcp-server
# How to get: https://github.com/settings/tokens
# Scopes needed: repo, read:org, read:user
export GITHUB_TOKEN="ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE"

# -----------------------------------------------------------------------------
# Rootly Integration
# -----------------------------------------------------------------------------
# Required for: rootly
# How to get: https://rootly.com/account/api-keys
export ROOTLY_API_KEY="rootly_YOUR_API_KEY_HERE"

# -----------------------------------------------------------------------------
# Optional: Custom paths
# -----------------------------------------------------------------------------
# Memory storage location (default: ~/.claude/memory/memory.json)
# export MEMORY_FILE_PATH="${HOME}/custom/path/memory.json"

# EXAMPLE Knowledge Base config (default: ~/.example-kb/config.json)
# export KNOWLEDGE_BASE_CONFIG="${HOME}/.example-kb/config.json"

# Repository root (auto-detected by sync script)
# export REPO_ROOT="$(git rev-parse --show-toplevel)"

# -----------------------------------------------------------------------------
# Grafana Integration
# -----------------------------------------------------------------------------
# Required for: grafana-cloud
# How to get: monitoring.example.com → Administration → Service accounts → Add token
export GRAFANA_CLOUD_SA_TOKEN="glsa_YOUR_GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN"

# Required for: grafana-selfhosted
# How to get: <your-grafana-url>/org/serviceaccounts
export GRAFANA_SELFHOSTED_URL="https://YOUR_GRAFANA_SELFHOSTED_URL"
export GRAFANA_SELFHOSTED_SA_TOKEN="glsa_YOUR_GRAFANA_SELFHOSTED_SERVICE_ACCOUNT_TOKEN"

# -----------------------------------------------------------------------------
# Atlassian Integration (Jira + Confluence)
# -----------------------------------------------------------------------------
# Required for: atlassian
# How to get API token: https://id.atlassian.com/manage-profile/security/api-tokens
export ATLASSIAN_EMAIL="your.email@company.com"
export JIRA_URL="https://YOUR_ORG.atlassian.net"
export JIRA_API_TOKEN="YOUR_JIRA_API_TOKEN_HERE"
export CONFLUENCE_URL="https://YOUR_ORG.atlassian.net/wiki"
export CONFLUENCE_API_TOKEN="YOUR_CONFLUENCE_API_TOKEN_HERE"

# -----------------------------------------------------------------------------
# Notion Integration
# -----------------------------------------------------------------------------
# Required for: notion
# How to get: https://www.notion.so/my-integrations → New integration → Internal Integration Token
export NOTION_INTEGRATION_TOKEN="secret_YOUR_NOTION_INTEGRATION_TOKEN_HERE"

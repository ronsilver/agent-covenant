{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/baseline-skills.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/require-read.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/git-guardrails.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/word-budget.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/injection-scan.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/done-gate.sh"
          },
          {
            "type": "command",
            "command": "${DETECTED_BASE}/hooks/memory-persist.sh"
          }
        ]
      }
    ]
  }
}
